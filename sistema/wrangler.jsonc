{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taika-sistema",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "taika", "database_id": "514ca2ac-26f9-4a42-9311-77aa91e40199", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "FOTOS", "bucket_name": "taika-fotos" }],
  "vars": { "TURNSTILE_SITEKEY": "1x00000000000000000000AA" },
  "dev": { "port": 8787, "ip": "127.0.0.1" }
}
